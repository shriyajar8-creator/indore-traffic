# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indore_traffic?schema=public
REDIS_URL=redis://localhost:6379

# Authentication & Secrets
JWT_SECRET=super_secret_indore_traffic_jwt_key_2026_sih
JWT_EXPIRES_IN=7d

# Demo Mode & Environment Flags
DATA_MODE=SIMULATED_LIVE

# Map GIS Integration (Defaults to OpenStreetMap / MapLibre free tiles)
MAP_PROVIDER=OpenStreetMap
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAPBOX_ACCESS_TOKEN=your_optional_mapbox_token_here

# Demo User Passwords Override (Optional)
ADMIN_PASSWORD=Admin@123
POLICE_PASSWORD=Police@123
ROADS_PASSWORD=Roads@123
CIVILIAN_PASSWORD=User@123
